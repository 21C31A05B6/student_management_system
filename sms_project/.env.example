# =============================================================================
#  SECURITY & ENVIRONMENT CONFIGURATION — Student Management System
#  Copy this file to .env and fill in your values.
#  NEVER commit the .env file to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# Django Core
# ---------------------------------------------------------------------------

# Generate a strong secret key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-me-with-a-strong-random-secret-key

# Set to False in production (REQUIRED on Render)
DJANGO_DEBUG=False

# Comma-separated list of allowed hosts — add your Render domain here
DJANGO_ALLOWED_HOSTS=student-management-system-iyku.onrender.com,student-management-system-n48c.onrender.com,localhost,127.0.0.1

# ---------------------------------------------------------------------------
# Database — PostgreSQL (Render managed DB or external)
# Render provides DATABASE_URL automatically when you attach a PostgreSQL service.
# Leave DATABASE_URL set and the app will use it automatically.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ---------------------------------------------------------------------------
# Security (set all to True in production)
# ---------------------------------------------------------------------------
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_HSTS_SECONDS=31536000

# ---------------------------------------------------------------------------
# Static Files (WhiteNoise serves them in production — no extra service needed)
# ---------------------------------------------------------------------------
# No extra vars needed; WhiteNoise is configured automatically.

# ---------------------------------------------------------------------------
# Email (optional — defaults to console backend)
# ---------------------------------------------------------------------------
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=noreply@your-domain.com

# ---------------------------------------------------------------------------
# SMS / WhatsApp via Twilio (optional)
# ---------------------------------------------------------------------------
# SMS_BACKEND=twilio
# WHATSAPP_BACKEND=twilio
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_FROM_NUMBER=+1xxxxxxxxxx
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
